# STM32 Build Artifacts
*.o
*.d
*.su
*.cyclo
*.elf
*.bin
*.hex
*.map
*.list

# Backup files
*.bak
*~
*.swp
*.swo

# IDE files (.cproject/.project/.settings/*.launch are tracked so projects can be
# built immediately after clone — only build outputs are ignored)

# Debug directories (keep structure but ignore compiled artifacts)
# Note: Debug folder structure is tracked, but build outputs are ignored

# OS files
.DS_Store
Thumbs.db

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
# Eclipse IDE
.metadata/
Debug/
Release/
*.log

# GUI build artifacts / dependencies (no source, generated output only)
demolition_robot_gui/**/node_modules/
demolition_robot_gui/**/dist/
demolition_robot_gui/**/.pio/
